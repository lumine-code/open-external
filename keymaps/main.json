{
  ".tree-view": {
    // Match Ctrl+Alt-click and Alt+Shift-click on path rows.
    "ctrl-alt-enter": "open-external:open",
    "alt-shift-enter": "open-external:show",
    // The tree view is where the flag matters, so this is where it is bound.
    // It held a bare alt-u at workspace scope too, which is the tier for
    // revealing a surface, and a config flag is not one.
    "e": "open-external:toggle"
  },
  "lumine-workspace lumine-pane:not(lumine-dock lumine-pane)": {
    "ctrl-alt-f12": "open-external:open",
    "alt-shift-f12": "open-external:show"
  }
}
