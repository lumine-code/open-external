{
  "context-menu": {
    ".tree-view .file, .tree-view .directory": [
      {
        "type": "separator"
      },
      {
        "label": "Open Externally",
        "command": "open-external:open"
      },
      {
        "label": "Show in Folder",
        "command": "open-external:show"
      },
      {
        "type": "separator"
      }
    ],
    ".image-editor, .pdf-view": [
      {
        "type": "separator"
      },
      {
        "label": "Open Externally",
        "command": "open-external:open"
      },
      {
        "label": "Show in Folder",
        "command": "open-external:show"
      },
      {
        "type": "separator"
      }
    ],
    // A file being edited is already open in the editor, so only revealing it
    // earns a place here. The tab carries no view of its own, hence a scope of
    // its own; `.active` is what makes it the file the workspace answers with.
    "lumine-text-editor:not([mini]), lumine-pane[data-active-item-path] .tab.active": [
      {
        "type": "separator"
      },
      {
        "label": "Show in Folder",
        "command": "open-external:show"
      },
      {
        "type": "separator"
      }
    ]
  },
  "menu": [
    {
      "label": "Packages",
      "submenu": [
        {
          "label": "Open External",
          "submenu": [
            {
              "label": "Toggle Automatic Opening",
              "command": "open-external:toggle"
            },
            {
              "label": "Open Externally",
              "command": "open-external:open"
            },
            {
              "label": "Show in Folder",
              "command": "open-external:show"
            }
          ]
        }
      ]
    }
  ]
}
