{
  "menu": [
    {
      "label": "File",
      "submenu": [
        {
          "label": "Open Externally",
          "command": "open-external:open",
          "group": "external",
          "order": 10
        },
        {
          "label": "Show in Folder",
          "command": "open-external:show",
          "group": "external",
          "order": 20
        }
      ]
    },
    {
      "label": "Packages",
      "submenu": [
        {
          "label": "Open External",
          "submenu": [
            {
              "label": "Toggle Automatic Opening",
              "command": "open-external:toggle"
            },
            {
              "label": "Open Externally",
              "command": "open-external:open"
            },
            {
              "label": "Show in Folder",
              "command": "open-external:show"
            }
          ]
        }
      ]
    }
  ],
  "context-menu": {
    ".image-editor, .pdf-view": [
      {
        "type": "separator"
      },
      {
        "label": "Open Externally",
        "command": "open-external:open",
        "group": "external",
        "order": 10
      },
      {
        "label": "Show in Folder",
        "command": "open-external:show",
        "group": "external",
        "order": 20
      },
      {
        "type": "separator"
      }
    ],
    // The tab carries no view of its own, hence a scope of its own;
    // `.active` is what makes it the file the workspace answers with.
    "lumine-pane[data-active-item-path] .tab.active": [
      {
        "type": "separator"
      },
      {
        "label": "Show in Folder",
        "command": "open-external:show",
        "before": ["tree-view:rename", "diff-view:enable"],
        "afterGroupContaining": [
          "pane:detach",
          "pane:close",
          "tabs:detach-tab",
          "tabs:open-in-new-window",
          "tabs:split-up",
          "tabs:close-tab"
        ],
        "group": "extensions",
        "order": 10
      },
      {
        "type": "separator"
      }
    ]
  }
}
